# Copy this file to .env and fill in your own values. NEVER commit .env.
# With no keys at all the app still runs in demo mode (simulated PayPal + scripted AI wording).

PORT=3000
BASE_URL=http://localhost:3000

# --- PayPal SANDBOX (developer.paypal.com > Apps & Credentials > Sandbox) ---
# Leave empty to use the built-in simulated PayPal.
PAYPAL_ENVIRONMENT=sandbox      # sandbox only; the app refuses to start with anything else
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: needed only if you register a webhook in the PayPal dashboard
PAYPAL_WEBHOOK_ID=

# --- AI model (pick one or both; both have free tiers) ---
# LLM_PROVIDER can be: gemini | groq | compat | mock   (auto-detected from the keys below if empty)
# Configured providers are tried in order (your choice first), then the offline mock.
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
# Models differ per account: run `node scripts/check-ai.js` to see which your key can use.
GROQ_MODEL=openai/gpt-oss-120b
# Any OpenAI-compatible endpoint (OpenRouter, Together, local Ollama...). Key optional for Ollama.
# Example OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Example Ollama:     LLM_BASE_URL=http://localhost:11434/v1     LLM_MODEL=llama3.2
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Seller dashboard key (change it!) ---
SELLER_KEY=change-me
# Signs login cookies; set a long random value on any public host (otherwise sign-ins end at each restart)
SESSION_SECRET=
# true behind a reverse proxy such as Render, so rate limits and the login lockout use each visitor's address
TRUST_PROXY=false
# The buyer sign-in code is shown on screen (no mail service in this sandbox demo); set false to hide it
BUYER_DEMO_CODES=true
# Optional: on = a second AI check flags manipulation the code patterns miss (one extra model call per message; it can only add flags)
AI_INJECTION_CHECK=
